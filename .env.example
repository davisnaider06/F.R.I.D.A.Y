# Copie este arquivo para .env e preencha os valores.
# O .env fica fora do git (.gitignore); este aqui entra.

# Qual provider usar: gemini ou anthropic.
# Trocar de modelo é configuração, não código — nenhum arquivo .py muda.
FRIDAY_PROVIDER=gemini

# --- gemini (grátis) -------------------------------------------------------
# aistudio.google.com/apikey — camada gratuita, sem cartão.
GEMINI_API_KEY=

# --- anthropic (pré-pago) --------------------------------------------------
# console.anthropic.com > API keys. Precisa de créditos comprados: a
# assinatura do Claude é produto SEPARADO e não dá acesso à API.
ANTHROPIC_API_KEY=
